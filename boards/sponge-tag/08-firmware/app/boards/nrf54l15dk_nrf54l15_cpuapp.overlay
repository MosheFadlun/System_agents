/*
 * sponge-tag pin map on the nRF54L15 DK (develop before the boards arrive).
 * Matches 01-spec/analyses/A04 and 03-schematic net names:
 *   LED_GPIO = P1.10 (DK led1), BTN_GPIO = P1.13 (DK button0),
 *   I2C_SDA = P1.11, I2C_SCL = P1.12 (TWIM21) -> SHT40 breakout wired to the DK header,
 *   UART_TX/RX = P1.04/P1.05 (UARTE20, same as the DK console).
 */
/ {
	aliases {
		status-led = &led1;
		user-button = &button0;
	};
};

&pinctrl {
	i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 11)>,
				<NRF_PSEL(TWIM_SCL, 1, 12)>;
		};
	};

	i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 11)>,
				<NRF_PSEL(TWIM_SCL, 1, 12)>;
			low-power-enable;
		};
	};
};

&i2c21 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";

	sht40: sht4x@44 {
		compatible = "sensirion,sht4x";
		reg = <0x44>;
		repeatability = <2>; /* high, as assumed in A01 */
	};
};
